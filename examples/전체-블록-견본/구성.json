  "teacher": {
    "memo": ["수업용 견본입니다. 영상 주소는 형식 예시이므로 배부 전에 실제 수업 영상으로 교체하세요."],
    "solutions": [
      {"item": "q1", "answer": "빈칸은 차례로 $4$, $6$이고 관계식은 $y=2x$이다.", "steps": ["봉지 수에 $2$를 곱하면 구슬 수가 된다.", "따라서 봉지 수가 $2$, $3$일 때 구슬 수는 각각 $4$, $6$이다."]},
      {"item": "q2", "answer": "차례로 $O$, $X$이고 흐름도의 빈칸은 $2$이다.", "steps": ["$x=3$을 대입하면 $y=6$이다.", "$x$가 $1$ 증가하면 $y$는 $2$ 증가한다."]},
      {"item": "q3", "answer": "②이고 짝은 $-2$와 $-4$, $0$과 $0$, $2$와 $4$이다.", "steps": ["$y=2x$에 각 값을 대입한다.", "$x=5$이면 $y=10$이다."]},
      {"item": "q4", "answer": "세 점은 $(-2,-4)$, $(0,0)$, $(2,4)$이고 그래프는 원점을 지나는 직선이다.", "steps": ["각 $x$에 $2$를 곱해 $y$를 구한다.", "세 점을 찍고 이 점들을 지나는 직선을 긋는다."], "rubric": ["세 점의 좌표를 바르게 나타냈는가?", "직선이 원점을 지나는가?"]},
      {"item": "q5", "answer": "점은 $2$, $4$, $6$이고 순서는 값 정하기, 계산, 점 찍기, 직선 긋기이다.", "steps": ["각 $x$에 $2$를 곱한다.", "계산된 값들을 수직선 위에 표시한다."]},
      {"item": "q6", "answer": "막대 높이는 차례로 $2$, $4$, $6$이다.", "steps": ["$x=1,2,3$을 각각 $y=2x$에 대입한다.", "대응하는 $y$의 값을 막대 높이로 나타낸다."]},
      {"item": "q7", "answer": "$a=2$에서는 $x$가 증가할 때 $y$가 증가하고, $a=-2$에서는 감소한다.", "steps": ["$x=1$과 $x=2$에서 두 식의 값을 각각 비교한다.", "$2x$의 값은 $2$에서 $4$로, $-2x$의 값은 $-2$에서 $-4$로 변한다."], "rubric": ["증가와 감소의 변화를 구별했는가?"]}
    ]
  }
